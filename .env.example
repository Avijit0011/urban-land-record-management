# Database settings
DATABASE_URL=postgresql://gis_user:gis_password@localhost:5432/land_record_db
SQLITE_FALLBACK_PATH=./land_record_fallback.db

# GIS Configuration
TARGET_CRS=EPSG:3857
DISPLAY_CRS=EPSG:4326

# Confidence Thresholds
CONFIDENCE_HIGH=0.85
CONFIDENCE_MED=0.60

# Application Mode
DEMO_MODE=true
SECRET_KEY=dev_secret_key_12345

# xAI / Grok Integration
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2-latest

